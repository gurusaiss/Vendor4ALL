# Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or set your key. If omitted, the app runs in manual/mock fallback mode.
GEMINI_API_KEY=""

# Only needed when this server is deployed standalone (e.g. on Render) while
# the frontend is hosted separately (e.g. Firebase Hosting). Comma-separated
# list of the frontend origin(s) allowed to call this API via CORS.
# Example: "https://vendor4all.web.app,https://vendor4all.firebaseapp.com"
ALLOWED_ORIGINS=""

# Frontend only (read by Vite at build time, not by server.ts).
# Only needed when the frontend and API are deployed to different hosts.
# Set this to the deployed API's full origin before running `npm run build`.
# Leave empty for local dev (Vite's dev proxy forwards /api to localhost:3000).
# Example: "https://vendor4all-api.onrender.com"
VITE_API_BASE_URL=""
